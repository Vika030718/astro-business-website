---
const { item, variant = "default" } = Astro.props;
---

<div class={`about-badge about-badge--${variant}`}>
  <span class="about-badge__icon" aria-hidden="true">
    {
      item.icon === "location" && (
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="0.5em"
          height="0.5em"
          viewBox="0 0 24 24"
        >
          {" "}
          <path d="M0 0h24v24H0z" fill="none" />{" "}
          <path
            fill="#A1CD42"
            d="M12 15.5a3.5 3.5 0 1 1 0-7a3.5 3.5 0 0 1 0 7M9.5 12a2.5 2.5 0 1 0 5 0a2.5 2.5 0 0 0-5 0"
          />{" "}
          <path
            fill="#A1CD42"
            d="M12 4.5a7.5 7.5 0 1 0 0 15a7.5 7.5 0 0 0 0-15M5.5 12a6.5 6.5 0 1 1 13 0a6.5 6.5 0 0 1-13 0"
          />{" "}
        </svg>
      )
    }

    {
      item.icon === "team" && (
      <svg viewBox="0 0 48 48" stroke="var(--color-primary)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"> <path d="M18 23a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z"></path> <path d="M34 24a6 6 0 1 0 0-12 6 6 0 0 0 0 12Z"></path> <path d="M6 40c1.5-8 6-12 12-12s10.5 4 12 12"></path> <path d="M26 32c2-2.5 4.5-3.5 8-3.5 5 0 8 3.5 9 10.5"></path> </svg>
      )
    }

    {
      item.icon === "headset" && (
      <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
	<path d="M0 0h24v24H0z" fill="none" />
	<path fill="var(--color-primary)" fill-rule="evenodd" d="M12 4.033a6.933 6.933 0 0 0-6.933 6.934v1.6a.533.533 0 0 1-1.067 0v-1.6a8 8 0 1 1 16 0v4.266a3.733 3.733 0 0 1-3.733 3.734h-2.255c-.293.621-1.083 1.066-2.012 1.066c-1.178 0-2.133-.716-2.133-1.6c0-.883.955-1.6 2.133-1.6c.929 0 1.72.446 2.012 1.067h2.255a2.667 2.667 0 0 0 2.666-2.667v-4.266A6.933 6.933 0 0 0 12 4.033m.868 14.122c.184.138.199.247.199.278s-.014.14-.199.278c-.184.139-.487.256-.868.256c-.38 0-.684-.117-.868-.256c-.184-.138-.199-.247-.199-.278c0-.03.014-.14.199-.278c.184-.138.487-.255.868-.255c.38 0 .684.117.868.255m-4.601-7.188H8.8V14.7h-.533c-.59 0-1.067-.478-1.067-1.067v-1.6c0-.589.478-1.066 1.067-1.066m-2.134 1.066c0-1.178.955-2.133 2.134-2.133H8.8c.59 0 1.067.478 1.067 1.067V14.7c0 .59-.478 1.067-1.067 1.067h-.533a2.133 2.133 0 0 1-2.134-2.134zm9.6-1.066H15.2V14.7h.533c.59 0 1.067-.478 1.067-1.067v-1.6c0-.589-.478-1.066-1.067-1.066m2.134 1.066A2.133 2.133 0 0 0 15.733 9.9H15.2c-.59 0-1.067.478-1.067 1.067V14.7c0 .59.478 1.067 1.067 1.067h.533a2.133 2.133 0 0 0 2.134-2.134z" clip-rule="evenodd" />
</svg>

      )
    }

    {
      item.icon === "shield" && (
<svg
  viewBox="0 0 48 48"
  fill="none"
  stroke="var(--color-primary)"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d="M24 6l16 6v11c0 10-6.5 16.5-16 20-9.5-3.5-16-10-16-20V12l16-6Z"></path>
  <path d="M16 24l6 6 11-13"></path>
</svg>
      )
    }
  </span>

  <span class="about-badge__text">{item.label}</span>
</div>
