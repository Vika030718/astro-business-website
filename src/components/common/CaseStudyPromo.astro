---
const {
  eyebrow,
  title,
  text,
  tags = [],
  buttonLabel,
  buttonHref,
} = Astro.props;

import Button from "./../common/Button.astro";
---

<section class="case-study-promo" aria-labelledby="case-study-promo-title">
  <div class="case-study-promo__content">
    <p class="eyebrow">{eyebrow}</p>
    <h2 id="case-study-promo-title" class="case-study-promo__title">
      {title}
    </h2>
    <p class="case-study-promo__text">{text}</p>


    <Button variant="primary" href={buttonHref}>
        {buttonLabel} <svg class="button__arrow" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </svg>
    </Button>
    
  </div>

  <div class="case-study-promo__panel" aria-hidden="true">
    <span class="case-study-promo__panel-label">Client story</span>

    <ul class="case-study-promo__tags">
      {tags.map((tag) => (
        <li>{tag}</li>
      ))}
    </ul>
  </div>
</section>