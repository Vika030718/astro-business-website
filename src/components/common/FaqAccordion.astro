---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<div class="faq-page__items">
  {items.map((item) => (
    <details class="faq-page__item">
      <summary class="faq-page__question">
        <span>{item.question}</span>

        <span class="faq-page__icon" aria-hidden="true">
          +
        </span>
      </summary>

      <div class="faq-page__answer">
        <p>{item.answer}</p>
      </div>
    </details>
  ))}
</div>

