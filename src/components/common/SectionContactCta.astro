---
import { siteContent } from "../../i18n/siteContent";
type Lang = keyof typeof siteContent;
const { lang = "en" } = Astro.props as { lang?: Lang };
const prefix = lang === "fr" ? "/fr" : "";
const SectionContactCtaText = siteContent[lang].sections.contactCta;
import { companyInfo } from "../../data/companyInfo";
---

<section class="home-contact-cta">
  <div class="container">
    <div class="home-contact-cta__inner">
      <div class="home-contact-cta__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24">
          <path d="M12 3 20 6v6c0 5-3.2 8.5-8 10-4.8-1.5-8-5-8-10V6l8-3Z"
          ></path>
          <path d="m8.5 12 2.2 2.2 4.8-5"></path>
        </svg>
      </div>

      <div class="home-contact-cta__content">
        <h2 class="main-title">{SectionContactCtaText.title}</h2>
        <p class="home-contact-cta__text">{SectionContactCtaText.text}</p>
        <p class="home-contact-cta__text">{SectionContactCtaText.faq} <a href="/faq/" class="link">{SectionContactCtaText.faqButtonText}</a></p>
      </div>

      <div class="home-contact-cta__actions">
        <a class="button button--primary" href={companyInfo.emailHref}>
          <span class="home-contact-cta__button-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path d="M4 6h16v12H4V6Z"></path>
              <path d="m4 7 8 6 8-6"></path>
            </svg>
          </span>
          {SectionContactCtaText.emailLabel}
        </a>

        <a class="button button--secondary" href={companyInfo.phoneHref}>
          <span class="home-contact-cta__button-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <path
                d="M8 5 6 7c-.5.5-.7 1.2-.5 1.9 1.3 4.8 4.8 8.3 9.6 9.6.7.2 1.4 0 1.9-.5l2-2-3.5-3.5-1.7 1.7c-1.8-.8-3.2-2.2-4-4L11.5 8.5 8 5Z"
              ></path>
            </svg>
          </span>
          {companyInfo.phone}
        </a>
      </div>
    </div>
  </div>
</section>
