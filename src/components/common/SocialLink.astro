---
const { platform, username } = Astro.props;

const href = `https://www.${platform}.com/${username}`;
const label = platform.charAt(0).toUpperCase() + platform.slice(1);
---

<a
  class="social-link"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Visit BusinessCompany on ${label}`}
>
  {
    platform === "facebook" && (
      <svg class="social-link__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M14 8.5V7c0-.7.5-1 1.1-1H17V3h-2.6C11.7 3 10 4.7 10 7.2v1.3H7.8V12H10v9h3.6v-9h2.7l.5-3.5H14Z" />
      </svg>
    )
  }

  {
    platform === "linkedin" && (
      <svg class="social-link__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6.7 9H3.4v12h3.3V9ZM5 3a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm16 11.2c0-3.3-1.8-5.4-4.5-5.4-1.8 0-2.8 1-3.3 1.8V9H10v12h3.3v-6.3c0-1.7.9-2.7 2.2-2.7 1.2 0 2.1.8 2.1 2.7V21H21v-6.8Z" />
      </svg>
    )
  }

  {
    platform === "instagram" && (
      <svg class="social-link__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3Zm0 3A1.5 1.5 0 0 0 6 7.5v9A1.5 1.5 0 0 0 7.5 18h9a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 16.5 6h-9ZM12 8a4 4 0 1 1 0 8 4 4 0 0 1 0-8Zm0 2.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3Zm4.3-3.2a.9.9 0 1 1 0 1.8.9.9 0 0 1 0-1.8Z" />
      </svg>
    )
  }
</a>
