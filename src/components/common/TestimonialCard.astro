---
const { item } = Astro.props;

const stars = Array.from({ length: item.rating ?? 5 });
---

<article class="testimonial-card">
  <div class="testimonial-card__quote-icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
      <path d="M0 0h24v24H0z" fill="none" />
      <path fill="currentColor" d="M9.135 9h3L10 14.608H7zm5 0h3L15 14.608h-3z" />
    </svg>
    
  </div>

  <blockquote class="testimonial-card__quote">
    {item.quote}
  </blockquote>

  <div
    class="testimonial-card__stars"
    aria-label={`${item.rating ?? 5} star rating`}
  >
    {stars.map(() => <span>★</span>)}
  </div>

  <p class="testimonial-card__author">
    — {item.author}
  </p>

  <div class="testimonial-card__divider"></div>

  <div class="testimonial-card__footer">
    <div class="testimonial-card__company">
      <span class="testimonial-card__company-mark">
        {item.companyMark}
      </span>

      <strong>{item.company}</strong>
    </div>
  </div>
</article>
