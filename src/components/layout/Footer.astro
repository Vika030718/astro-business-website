---
import { siteContent } from "../../i18n/siteContent";
import { companyInfo } from "../../data/companyInfo";

const { lang = "en" } = Astro.props;

const footer = siteContent[lang].footer;
import SocialLink from "../common/SocialLink.astro";

import { Image } from "astro:assets";
import logo from "../../assets/images/logo.png";
import { getRoute } from "../../data/siteRoutes";
---

<footer class="site-footer">
  <div class="site-footer__main container">
    <div class="site-footer__brand">
      <a class="site-footer__logo" href={lang === "fr" ? "/fr/" : "/"}>
        <Image
          src={logo}
          alt={footer.logo}
          width={720}
          height={480}
          loading="lazy"
        />
      </a>

      <p class="site-footer__description">
        {footer.description}
      </p>
    </div>

    <div class="site-footer__column">
      <h3 class="site-footer__title">{footer.services.title}</h3>

      <ul class="site-footer__list">
        {footer.services.items.map((item) => (
          <li>
            <a class="site-footer__link" href={getRoute(item.routeKey, lang)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="site-footer__column">
      <h3 class="site-footer__title">{footer.quickLinks.title}</h3>

      <ul class="site-footer__list">
        {footer.quickLinks.items.map((item) => (
          <li>
            <a class="site-footer__link" href={getRoute(item.routeKey, lang)}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="site-footer__column">
      <h3 class="site-footer__title">{footer.serviceAreas.title}</h3>

      <ul class="site-footer__list">
        {
          footer.serviceAreas.items.map((item) => (
            <li>
              <span class="site-footer__text">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="site-footer__column site-footer__contact">
      <h3 class="site-footer__title">{footer.contact.title}</h3>

      <ul class="site-footer__contact-list">
        <li class="site-footer__contact-item">
          <span class="site-footer__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24">
              <path d="M0 0h24v24H0z" fill="none" />
              <path fill="none" stroke="currentColor" stroke-dasharray="62" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3c0.5 0 2.5 4.5 2.5 5c0 1 -1.5 2 -2 3c-0.5 1 0.5 2 1.5 3c0.39 0.39 2 2 3 1.5c1 -0.5 2 -2 3 -2c0.5 0 5 2 5 2.5c0 2 -1.5 3.5 -3 4c-1.5 0.5 -2.5 0.5 -4.5 0c-2 -0.5 -3.5 -1 -6 -3.5c-2.5 -2.5 -3 -4 -3.5 -6c-0.5 -2 -0.5 -3 0 -4.5c0.5 -1.5 2 -3 4 -3Z">
                <animate fill="freeze" attributeName="stroke-dashoffset" dur="0.6s" values="62;0" />
              </path>
            </svg>          
          </span>
          <div>
            <a
              class="site-footer__contact-link"
              href={companyInfo.phoneHref}
            >
              {companyInfo.phone}
            </a>
            <p class="site-footer__small">{footer.contact.hours}</p>
          </div>
        </li>

        <li class="site-footer__contact-item">
          <span class="site-footer__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="1.2em" height="1.2em" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="none" stroke="currentColor" stroke-dasharray="62" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 3c0.5 0 2.5 4.5 2.5 5c0 1 -1.5 2 -2 3c-0.5 1 0.5 2 1.5 3c0.39 0.39 2 2 3 1.5c1 -0.5 2 -2 3 -2c0.5 0 5 2 5 2.5c0 2 -1.5 3.5 -3 4c-1.5 0.5 -2.5 0.5 -4.5 0c-2 -0.5 -3.5 -1 -6 -3.5c-2.5 -2.5 -3 -4 -3.5 -6c-0.5 -2 -0.5 -3 0 -4.5c0.5 -1.5 2 -3 4 -3Z">
              <animate fill="freeze" attributeName="stroke-dashoffset" dur="0.6s" values="62;0" />
            </path>
          </svg>          
          </span>
          <div>
            <a
              class="site-footer__contact-link"
              href={`tel:${footer.contact.afterHoursHref}`}
            >
              {footer.contact.afterHoursPhone}
            </a>
            <p class="site-footer__small">{footer.contact.afterHoursLabel}</p>
          </div>
        </li>

        <li class="site-footer__contact-item">
          <span class="site-footer__icon"><svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
            <path d="M0 0h24v24H0z" fill="none" />
            <path fill="currentColor" d="M22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2zm-2 0l-8 5l-8-5zm0 12H4V8l8 5l8-5z" />
          </svg>
          </span>
          <a
            class="site-footer__contact-link"
            href={companyInfo.emailHref}
          >
            {footer.contact.email}
          </a>
        </li>

        <li class="site-footer__contact-item">
          <span class="site-footer__icon">
              <svg width="15" height="18" viewBox="0 0 43 53" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M21.5 0.5C24.2577 0.5 26.9883 1.04273 29.5361 2.09668C32.0839 3.15069 34.3996 4.69511 36.3496 6.64258C38.2996 8.59012 39.8461 10.9028 40.9014 13.4473C41.9566 15.9917 42.5 18.7186 42.5 21.4727C42.5 29.6911 37.6299 37.0906 32.9062 42.3711L32.4502 42.875C30.348 45.1608 28.0873 47.296 25.6855 49.2656C24.3344 50.3644 22.9383 51.4066 21.502 52.3916C20.0613 51.3936 18.6586 50.3743 17.3145 49.2666V49.2656L16.4199 48.5195C14.3494 46.7597 12.389 44.8757 10.5498 42.875H10.5488C5.68814 37.5642 0.5 29.9557 0.5 21.4727C0.500038 18.7186 1.04338 15.9917 2.09863 13.4473C3.15393 10.9028 4.70039 8.59012 6.65039 6.64258C8.60036 4.69511 10.9161 3.15069 13.4639 2.09668C16.0117 1.04273 18.7423 0.5 21.5 0.5ZM21.5 13.2188C19.3087 13.2188 17.207 14.0881 15.6572 15.6357C14.1074 17.1836 13.2364 19.2834 13.2363 21.4727C13.2363 23.662 14.1074 25.7617 15.6572 27.3096C17.207 28.8573 19.3086 29.7275 21.5 29.7275C23.6914 29.7275 25.793 28.8573 27.3428 27.3096C28.8926 25.7617 29.7637 23.662 29.7637 21.4727C29.7636 19.2834 28.8926 17.1836 27.3428 15.6357C25.793 14.0881 23.6913 13.2188 21.5 13.2188Z" fill="#A1CD42" stroke="white"/>
              </svg>
          </span>
          <span class="site-footer__text">{footer.contact.address}</span>
        </li>
      </ul>
      <h3 class="site-footer__title">{footer.social.title}</h3>
      <div>
        <SocialLink platform="facebook" username="BusinessCompanysolutions" />
        <SocialLink
          platform="linkedin"
          username="company/BusinessCompany-professional-services-solutions/"
        />
        <SocialLink platform="instagram" username="BusinessCompanysolutions" />
      </div>
    </div>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p class="site-footer__canadian">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
          viewBox="0 0 48 48"
        >
          <path d="M0 0h48v48H0z" fill="none"></path>
          <path
            fill="none"
            stroke="var(--color-primary)"
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M24.005 32.976c0-1.66 1.1-1.585 2.722-.686c1.296.763 2.6 1.509 3.897 2.27c.245.145.418.308.552-.146c.145-.494.578-.665 1.045-.716c.408-.044.8.058 1.194.15c.732.169 1.463.342 2.31.541c-.227-.523-.403-.919-.569-1.318c-.224-.537-.474-1.066-.65-1.62c-.206-.65-.23-1.292.428-1.727c.285-.188.09-.293-.061-.401c-.398-.285-.812-.549-1.196-.853c-.92-.728-.854-1.477.195-1.992c.946-.464 1.917-.874 2.874-1.314c.261-.12.513-.264.79-.408c-1.076-1.092-1.129-1.734-.294-2.956c.513-.751 1.03-1.5 1.54-2.253c.074-.11.246-.22.132-.369c-.054-.071-.217-.071-.33-.072c-.927-.005-1.853-.001-2.78-.004c-1.244-.003-1.544-.23-1.86-1.477c-.077-.302-.16-.34-.392-.168c-.588.44-1.177.88-1.776 1.304c-.599.423-1.185.877-1.822 1.23c-.96.531-1.848-.047-1.874-1.181a7.5 7.5 0 0 1 .068-1.001c.165-1.448.337-2.896.51-4.368c-1.976.381-2.265.21-3.093-1.7c-.492-1.137-1.005-2.263-1.52-3.42c-.245.2-.292.433-.38.633c-.506 1.14-.994 2.29-1.5 3.43c-.492 1.11-1.28 1.51-2.347 1.14c-.455-.158-.455-.007-.41.378q.276 2.337.514 4.678c.062.602-.094 1.137-.628 1.46c-.52.313-1.019.136-1.475-.175c-.69-.47-1.369-.96-2.05-1.445c-.524-.375-1.044-.757-1.605-1.162c-.046.169-.072.246-.089.325c-.263 1.221-.613 1.514-1.832 1.519c-.926.003-1.853-.002-2.779.004c-.13.001-.308-.075-.386.084c-.077.157.083.261.16.373c.581.855 1.182 1.696 1.75 2.56c.526.801.452 1.57-.163 2.29c-.1.118-.291.167-.284.426c1.163.526 2.35 1.044 3.521 1.6c1.154.547 1.216 1.325.186 2.089c-.452.336-.918.651-1.44 1.02c.85.471.934 1.151.685 1.923c-.134.415-.31.816-.479 1.219c-.223.53-.457 1.056-.738 1.702l.802-.184c.685-.16 1.368-.337 2.058-.474c.792-.158 1.434.03 1.64.582c.198.532.408.377.73.187c1.346-.798 2.692-1.596 4.054-2.364c1.176-.662 2.34-.537 2.445.837c.29 3.779-.973 12.513-.973 12.513h0C11.607 44.983 2.5 35.556 2.5 24C2.5 12.12 12.126 2.49 24 2.49S45.5 12.12 45.5 24c0 10.35-7.306 18.992-17.04 21.047"
          ></path>
        </svg>
        {footer.bottom.canadian}
      </p>

      <p class="site-footer__copyright">
        {footer.bottom.copyright}
      </p>

      <div class="site-footer__legal">
        <a href="/privacy-policy/">{footer.bottom.privacy}</a>
        <span></span>
        <a href="/terms-of-service/">{footer.bottom.terms}</a>
      </div>
    </div>
  </div>
</footer>
