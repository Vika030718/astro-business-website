---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionContactCta from "../components/common/SectionContactCta.astro";

export async function getStaticPaths() {
  const postModules = import.meta.glob("../posts/*.md", { eager: true });

  return Object.entries(postModules).map(([path, post]) => {
    const slug = path
      .split("/")
      .pop()
      ?.replace(".md", "");

    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;

const { frontmatter, Content } = post;

const title = frontmatter.title;
const description = frontmatter.description;
const pubDate = frontmatter.pubDate;
const author = frontmatter.author;
const image = frontmatter.image?.url;
const imageAlt = frontmatter.image?.alt || "";
const tags = frontmatter.tags || [];

const formattedDate = pubDate
  ? new Date(pubDate).toLocaleDateString("en-CA", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : "";
---

<BaseLayout
  lang="en"
  title={title}
  description={description}
  canonicalPath={Astro.url.pathname}
  noFrenchAlternate={true}
  disabledLanguages={["fr"]}
>
  <article class="blog-post">
    <div class="container">
      <a class="blog-post__back" href="/blog/">Back to blog</a>

      <header class="blog-post__header">
        <div class="blog-post__meta">
          {tags[0] && <span>{tags[0]}</span>}
          {formattedDate && <span>{formattedDate}</span>}
          {author && <span>{author}</span>}
        </div>

        <h1 class="blog-post__title">{title}</h1>

        {description && (
          <p class="blog-post__description">{description}</p>
        )}
      </header>

      {image && (
        <div class="blog-post__image">
          <img src={image} alt={imageAlt} />
        </div>
      )}

      <div class="blog-post__content">
        <Content />
      </div>
    </div>
  </article>

  <SectionContactCta />
</BaseLayout>